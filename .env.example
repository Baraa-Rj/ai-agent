# Copy this file to .env and fill in the key for the provider you use.
# .env is ignored by git. Never commit a real key.

# --provider openrouter (the default)
OPENROUTER_API_KEY=

# --provider anthropic
ANTHROPIC_API_KEY=

# Optional defaults, overridden by --provider and --model
# AGENT_PROVIDER=anthropic
# AGENT_MODEL=claude-sonnet-5-5
